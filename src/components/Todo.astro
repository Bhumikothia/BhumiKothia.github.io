---
/**
 * A visible TODO marker. Shown ONLY while developing (`npm run dev`),
 * never in the published site. Run `npm run todos` for the full list.
 */
interface Props {
  text: string;
}
const { text } = Astro.props;
const show = import.meta.env.DEV;
---

{show && (
  <p class="my-3 rounded-lg border border-dashed border-amber-500 bg-amber-50 px-3 py-2 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-200">
    <strong>TODO:</strong> {text}
  </p>
)}
