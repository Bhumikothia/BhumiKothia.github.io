---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import { getProfile } from '../lib/data';
import { formatDate } from '../lib/format';
import { resolveImage } from '../lib/uploads';

const { data: profile } = await getProfile();
const entries = (await getCollection('beyond', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const rendered = await Promise.all(
  entries.map(async (e) => ({ entry: e, photo: resolveImage(e.data.photo), Content: (await render(e)).Content })),
);
const kindLabel = { outreach: 'Outreach', volunteering: 'Volunteering', hobby: 'Hobby', mentoring: 'Mentoring', other: 'Other' } as const;
---

<BaseLayout title="Beyond the Lab" description={`${profile.name} beyond the lab: outreach, volunteering and interests.`}>
  <PageHeader eyebrow="Beyond the Lab" title="Beyond the Lab" lead="Outreach, volunteering and the things that keep me curious outside research." />

  <div class="container-page py-14">
    {rendered.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2">
        {rendered.map(({ entry, photo, Content }) => (
          <article id={entry.id} class="card overflow-hidden">
            {photo && (
              <Image
                src={photo}
                alt={entry.data.photoAlt ?? ''}
                widths={[480, 720, 960]}
                sizes="(min-width: 640px) 30rem, 100vw"
                class="aspect-[3/2] w-full object-cover"
              />
            )}
            <div class="p-6">
              <p class="mb-2 flex items-center gap-2 text-xs text-muted">
                <span class="badge">{kindLabel[entry.data.kind]}</span>
                {entry.data.date && formatDate(entry.data.date, 'month')}
              </p>
              <h2 class="font-sans text-lg font-semibold">{entry.data.title}</h2>
              <div class="prose-site mt-2 text-sm"><Content /></div>
              {entry.data.link && (
                <a class="link mt-3 inline-flex items-center gap-1 text-sm" href={entry.data.link.url} rel="noopener" target="_blank">
                  {entry.data.link.label} <Icon name="external" class="size-3.5" />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <>
        <p class="max-w-2xl text-lg text-muted">More to come — this section is being written.</p>
        <Todo text="Add hobbies, outreach and volunteering entries in src/content/beyond/ (copy _example.md)." />
      </>
    )}
  </div>
</BaseLayout>
