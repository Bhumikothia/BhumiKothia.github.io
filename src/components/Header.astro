---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { href } from '../lib/format';
import { NAV } from '../lib/nav';

interface Props {
  name: string;
}
const { name } = Astro.props;


const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (path: string) => current.endsWith(path);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/90 backdrop-blur supports-[backdrop-filter]:bg-bg/75">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={href('/')} class="group flex items-center gap-2.5 whitespace-nowrap text-ink">
      <svg class="size-8 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" class="text-accent" stroke-width="1.5" />
        <rect x="8" y="10" width="11" height="5" rx="2.5" class="fill-accent" transform="rotate(-20 13.5 12.5)" />
        <rect x="13" y="17" width="12" height="5" rx="2.5" class="fill-life" transform="rotate(25 19 19.5)" />
        <path d="M13 14 Q15 18 18 19" fill="none" stroke="currentColor" class="text-muted" stroke-width="1" stroke-dasharray="1.5 1.5" />
      </svg>
      <span class="font-serif text-xl font-semibold tracking-tight group-hover:text-accent">{name}</span>
    </a>

    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-1 text-sm">
        {NAV.map((item) => (
          <li>
            <a
              href={href(item.path)}
              aria-current={isActive(item.path) ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-2 whitespace-nowrap transition-colors hover:text-accent',
                isActive(item.path) ? 'text-accent font-semibold' : 'text-muted',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <ThemeToggle />
      <details class="nav-menu relative xl:hidden">
        <summary
          class="inline-flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-muted hover:bg-surface-2 hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <span class="menu-open"><Icon name="menu" class="size-5" /></span>
          <span class="menu-close hidden"><Icon name="close" class="size-5" /></span>
        </summary>
        <nav aria-label="Main" class="card absolute right-0 mt-2 w-60 p-2 shadow-lg">
          <ul class="flex flex-col text-sm">
            {NAV.map((item) => (
              <li>
                <a
                  href={href(item.path)}
                  aria-current={isActive(item.path) ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-3 py-2.5 hover:bg-surface-2',
                    isActive(item.path) ? 'text-accent font-semibold' : 'text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-menu[open] .menu-open {
    display: none;
  }
  .nav-menu[open] .menu-close {
    display: inline;
  }
</style>

<script>
  // Close the mobile menu on Escape or when clicking outside it.
  const menu = document.querySelector<HTMLDetailsElement>('.nav-menu');
  if (menu) {
    const summary = menu.querySelector('summary')!;
    menu.addEventListener('toggle', () => {
      summary.setAttribute('aria-label', menu.open ? 'Close menu' : 'Open menu');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        summary.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
