---
/**
 * Circular "field of view" frame with an eyepiece reticle, used for the hero image.
 * Shows the headshot if provided, otherwise an illustrative micrograph.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos } from '../lib/images';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  class?: string;
}
const { src, alt, class: cls = '' } = Astro.props;
const fallback = photos.gramStain;
const image = src ?? fallback.src;
const ticks = Array.from({ length: 60 }, (_, i) => i);
---

<div class:list={['relative aspect-square', cls]}>
  <div class="absolute inset-[6%] overflow-hidden rounded-full bg-surface-2 shadow-[0_20px_60px_-20px_rgb(3_105_161/0.45)]">
    <Image
      src={image}
      alt={src ? (alt ?? '') : fallback.alt}
      widths={[288, 432, 576, 768]}
      sizes="(min-width: 1024px) 24rem, (min-width: 768px) 20rem, 18rem"
      quality={62}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
    {!src && <div class="absolute inset-0 rounded-full shadow-[inset_0_0_60px_18px_rgb(0_0_0/0.35)]" aria-hidden="true" />}
  </div>
  <!-- Reticle ring -->
  <svg class="pointer-events-none absolute inset-0 h-full w-full text-accent" viewBox="0 0 200 200" aria-hidden="true">
    <circle cx="100" cy="100" r="97" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5" />
    <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.35" />
    {ticks.map((i) => {
      const a = (i / 60) * Math.PI * 2;
      const long = i % 5 === 0;
      const r1 = 97;
      const r2 = long ? 91 : 94;
      return (
        <line
          x1={100 + r1 * Math.cos(a)}
          y1={100 + r1 * Math.sin(a)}
          x2={100 + r2 * Math.cos(a)}
          y2={100 + r2 * Math.sin(a)}
          stroke="currentColor"
          stroke-width={long ? 0.9 : 0.5}
          opacity="0.7"
        />
      );
    })}
  </svg>
  {!src && (
    <p class="absolute -bottom-2 left-1/2 w-max max-w-[92%] -translate-x-1/2 rounded-2xl border border-line bg-surface px-3 py-1 text-center font-mono text-[0.75rem] leading-snug text-muted">
      <span class="text-stain" aria-hidden="true">●</span> Bacillus subtilis · Gram stain ·{' '}
      <a class="underline decoration-dotted hover:text-accent" href={fallback.source} rel="noopener" target="_blank">{fallback.author}</a>,{' '}
      <a class="underline decoration-dotted hover:text-accent" href={fallback.licenseUrl} rel="noopener license" target="_blank">{fallback.license}</a>
    </p>
  )}
</div>
