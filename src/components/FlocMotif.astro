---
/**
 * Decorative motif: rod-shaped bacilli with EPS strands bridging them into a floc.
 * Purely decorative (aria-hidden). Uses currentColor so it follows the theme.
 */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
// [cx, cy, length, rotation°]
const rods: [number, number, number, number][] = [
  [60, 60, 34, 20], [118, 40, 28, -35], [150, 96, 38, 70], [96, 118, 30, -10],
  [196, 58, 26, 15], [220, 132, 34, -50], [160, 168, 28, 30], [252, 88, 24, 80], [84, 176, 26, 45],
];
const strands: [number, number][] = [[0, 1], [1, 2], [0, 3], [2, 3], [2, 4], [2, 5], [5, 6], [4, 7], [5, 7], [3, 8], [6, 8]];
---

<svg class={cls} viewBox="0 0 300 220" fill="none" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.5" stroke-dasharray="2 3">
    {strands.map(([a, b]) => (
      <path d={`M${rods[a][0]} ${rods[a][1]} Q ${(rods[a][0] + rods[b][0]) / 2 + 10} ${(rods[a][1] + rods[b][1]) / 2 - 10} ${rods[b][0]} ${rods[b][1]}`} />
    ))}
  </g>
  <g fill="currentColor">
    {rods.map(([x, y, len, rot]) => (
      <rect x={x - len / 2} y={y - 6} width={len} height="12" rx="6" transform={`rotate(${rot} ${x} ${y})`} opacity="0.85" />
    ))}
  </g>
</svg>
