---
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import FlocMotif from '../components/FlocMotif.astro';
import Icon from '../components/Icon.astro';
import MicroscopeField from '../components/MicroscopeField.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import PublicationItem from '../components/PublicationItem.astro';
import Todo from '../components/Todo.astro';
import { getProfile, getPublications, getRecognition, getStats, getTalks, plural, selfNames } from '../lib/data';
import { formatRange, formatDate, href } from '../lib/format';
import { roleLabel } from '../lib/jsonld';
import type { PhotoKey } from '../lib/images';

const { data: profile } = await getProfile();
const pubs = await getPublications();
const featured = pubs.filter((p) => p.data.featured).slice(0, 3);
const talks = (await getTalks()).slice(0, 3);
const awards = (await getRecognition()).slice(0, 2);
const s = await getStats();

const highlights = [
  { value: s.journalArticles, label: s.journalArticles === 1 ? 'peer-reviewed journal article' : 'peer-reviewed journal articles', tag: 'Article', link: '/publications/#articles' },
  { value: s.datasets, label: 'open research datasets on Mendeley Data', tag: 'Data', link: '/publications/#datasets' },
  { value: s.sequences, label: '16S rRNA sequences deposited in NCBI GenBank', tag: 'GenBank', link: '/publications/#data-deposits' },
  { value: s.presentations, label: `conference presentations (${s.oral} oral, ${s.posters} poster)`, tag: 'Talks', link: '/talks/' },
].filter((h) => h.value > 0);

const workflow: { photo: PhotoKey; step: string; title: string; text: string }[] = [
  { photo: 'plantAerial', step: '01', title: 'Sample', text: 'Bacteria are collected from real industrial and municipal waste streams.' },
  { photo: 'colonies', step: '02', title: 'Isolate & screen', text: 'Pure cultures are grown and screened for bioflocculant production.' },
  { photo: 'gramStain', step: '03', title: 'Identify', text: 'Strains are identified by morphology and 16S rRNA gene sequencing.' },
  { photo: 'floc', step: '04', title: 'Flocculate', text: 'Their natural polymers bind particles into flocs that settle out.' },
];

const description = `${profile.name} (published as ${profile.publishedAs}) is a Ph.D. researcher in environmental microbiology studying bioflocculant-producing bacteria for sustainable industrial wastewater treatment. Publications, datasets, talks and CV.`;
---

<BaseLayout description={description} ogType="profile">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-plate pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_70%_40%,black,transparent_70%)]" aria-hidden="true"></div>
    <div class="container-page relative grid items-center gap-12 py-14 sm:py-20 md:grid-cols-[1fr_22rem] lg:grid-cols-[1fr_26rem]">
      <div>
        <p class="eyebrow mb-4">Environmental microbiology · Wastewater treatment</p>
        <h1 class="text-5xl leading-[1.05] font-semibold sm:text-6xl lg:text-7xl">{profile.name}</h1>
        {profile.publishedAs && (
          <p class="mt-3 text-lg text-muted">
            Published as <span class="font-bold text-ink">{profile.publishedAs}</span>
            <span class="mx-2 text-line" aria-hidden="true">|</span>
            {profile.headline}
          </p>
        )}
        <p class="mt-6 max-w-2xl font-serif text-2xl leading-snug text-ink sm:text-[1.75rem]">{profile.tagline}</p>
        <p class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-muted">
          <span class="inline-flex items-center gap-1.5"><Icon name="flask" class="size-4 text-life" />ISTAR, {profile.affiliation.name}</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="pin" class="size-4 text-life" />{profile.location.display}</span>
        </p>
        <ProfileLinks profile={profile} class="mt-8" />
        {!profile.cv && <Todo text="Add a CV PDF without phone number (see profile.md)." />}
      </div>

      <div class="mx-auto w-72 sm:w-80 md:w-full">
        <MicroscopeField src={profile.photo} alt={profile.photoAlt} />
        {!profile.photo && <Todo text="Add a headshot (see profile.md); it will replace the micrograph here." />}
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="container-page py-14" aria-labelledby="highlights">
    <h2 id="highlights" class="sr-only">Research output at a glance</h2>
    <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {highlights.map((h) => (
        <li>
          <a href={href(h.link)} class="card group relative block h-full overflow-hidden p-5 transition-colors duration-200 hover:border-accent">
            <span class="badge badge-life absolute top-4 right-4">{h.tag}</span>
            <span class="block font-serif text-5xl leading-none font-semibold text-accent">{h.value}</span>
            <span class="mt-3 block text-sm leading-snug text-muted group-hover:text-ink">{h.label}</span>
          </a>
        </li>
      ))}
    </ul>
    {s.books > 0 && (
      <p class="mt-4 text-sm text-muted">
        Also author of {plural(s.books, 'book')} on bioflocculating bacteria:{' '}
        <a class="link" href={href('/publications/#books')}>see publications</a>.
      </p>
    )}
  </section>

  <!-- From waste stream to floc -->
  <section class="border-y border-line bg-surface py-16" aria-labelledby="workflow-h">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-2">The research, in four steps</p>
          <h2 id="workflow-h" class="text-3xl font-semibold sm:text-4xl">From waste stream to floc</h2>
        </div>
        <a class="btn" href={href('/research/')}>Read about the research <Icon name="arrow" /></a>
      </div>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {workflow.map((w) => (
          <li>
            <Figure photo={w.photo} label={`Step ${w.step}`} aspect="aspect-[4/3]" sizes="(min-width: 1024px) 18rem, (min-width: 640px) 45vw, 100vw" showCaption={false} />
            <h3 class="mt-4 font-sans text-lg font-bold">{w.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{w.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Selected work + talks -->
  <section class="container-page grid gap-12 py-16 lg:grid-cols-[1fr_20rem]">
    <div>
      <div class="mb-2 flex items-end justify-between gap-4">
        <h2 class="text-3xl font-semibold">Selected work</h2>
        <a class="link text-sm" href={href('/publications/')}>All publications &amp; datasets</a>
      </div>
      <div class="divide-y divide-line">
        {featured.map((entry) => <PublicationItem entry={entry} selfNames={selfNames(profile)} compact />)}
      </div>
    </div>

    <aside class="space-y-10">
      <div class="card p-6">
        <h2 class="mb-4 text-2xl font-semibold">Recent talks</h2>
        <ul class="space-y-4">
          {talks.map((t) => (
            <li class="border-l-2 border-life/60 pl-3">
              <a href={href(`/talks/#${t.id}`)} class="group block">
                <span class="block font-mono text-[0.75rem] text-muted uppercase">{formatRange(t.data.startDate, t.data.endDate)} · {roleLabel(t.data.role)}</span>
                <span class="block font-bold text-ink group-hover:text-accent">{t.data.eventShort ?? t.data.event}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="link mt-5 inline-block text-sm" href={href('/talks/')}>All conferences &amp; talks</a>
      </div>

      {awards.length > 0 && (
        <div class="card p-6">
          <h2 class="mb-4 text-2xl font-semibold">Recognition</h2>
          <ul class="space-y-4">
            {awards.map((a) => (
              <li class="flex gap-3">
                <Icon name="award" class="mt-0.5 size-5 shrink-0 text-stain" />
                <span>
                  <span class="block font-bold text-ink">{a.data.title}</span>
                  <span class="block text-sm text-muted">{a.data.issuer} · {formatDate(a.data.date, a.data.datePrecision)}</span>
                </span>
              </li>
            ))}
          </ul>
          <a class="link mt-5 inline-block text-sm" href={href('/recognition/')}>Recognition &amp; service</a>
        </div>
      )}
    </aside>
  </section>

  <!-- Plain-language pitch -->
  <section class="container-page pb-8">
    <div class="relative overflow-hidden rounded-3xl bg-accent-strong p-8 text-white sm:p-12 dark:bg-accent-soft dark:text-ink">
      <FlocMotif class="pointer-events-none absolute -right-6 -bottom-8 w-80 text-white/15 dark:text-accent/25" />
      <p class="font-mono text-xs tracking-[0.12em] uppercase opacity-80">In plain words</p>
      <h2 class="mt-2 max-w-2xl text-3xl font-semibold text-white sm:text-4xl dark:text-ink">Cleaner water, with fewer chemicals.</h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed opacity-90">
        Treatment plants add chemicals to make dirt in wastewater clump together and settle. I look for bacteria that make
        natural, biodegradable substances that can do the same job.
      </p>
      <a class="btn mt-7 border-white/30 bg-white text-accent-strong hover:border-white hover:bg-white/90 hover:text-accent-strong dark:border-line dark:bg-surface dark:text-ink" href={href('/research/')}>
        How it works <Icon name="arrow" />
      </a>
    </div>
  </section>
</BaseLayout>
