---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/format';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <div class="container-text py-28 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-semibold">This page settled somewhere else.</h1>
    <p class="mt-4 text-muted">The page you were looking for doesn't exist or has moved.</p>
    <a class="btn btn-primary mt-8" href={href('/')}>Back to the home page</a>
  </div>
</BaseLayout>
